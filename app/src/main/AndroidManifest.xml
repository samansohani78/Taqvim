<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- T-1103: the day-change alarm is set again after a reboot. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:name=".TaqvimApplication"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:localeConfig="@xml/locales_config"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.Taqvim"
    android:usesCleartextTraffic="false"
    tools:targetApi="33">

    <profileable
      android:shell="true"
      tools:targetApi="29" />

    <!-- T-1003: WorkManager is configured by TaqvimApplication (Configuration.Provider) with the subscription worker
         factory, so its default start-up initializer is removed. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>

    <!-- singleTop: links (T-1103) that arrive while the app is shown reach onNewIntent instead of a second copy.
         The launcher entries are the aliases below (T-1214), so shortcuts and links keep targeting this activity. -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTop">
      <!-- T-1103 (ADR-0016, docs/AUTOMATION.md): taqvim:// links only open screens; they never change data. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="taqvim" />
      </intent-filter>
    </activity>

    <!-- T-1214 (ADR-0022): exactly one launcher entry is enabled. The default icon is on unless the user turns on the
         day-number icon; LauncherIconSwitcher then enables the alias of today's day and disables the others. -->
    <activity-alias
      android:name=".LauncherDefault"
      android:enabled="true"
      android:exported="true"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
