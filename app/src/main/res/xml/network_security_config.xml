<?xml version="1.0" encoding="utf-8"?>
<!-- T-1804 (ADR-0017): HTTPS only, trusting the system certificate authorities; no user-installed CAs, no debug
     overrides. Subscriptions (T-1003) are the only network traffic. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
