    }
  ],
  "overrides": [
    {
      "module": "net.sf.kxml:kxml2",
      "license": "MIT",
      "versions": "*",
      "evidence": "https://github.com/kobjects/kxml2/blob/master/license.txt",
      "note": "POM declares 'BSD style' + 'Public Domain'; upstream license text is the MIT license (verified 2026-09-13)."
