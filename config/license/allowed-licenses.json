      "scopes": [
        "runtime",
        "build",
        "test"
      ]
    },
    {
      "id": "Unicode-3.0",
      "scopes": [
        "runtime",
        "build",
        "test"
      ]
    },
    {
      "id": "Unicode-DFS-2016",
      "scopes": [
        "runtime",
        "build",
        "test"
