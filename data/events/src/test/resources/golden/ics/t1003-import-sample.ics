# source: Taqvim synthetic iCalendar fixture for T-1003 import — all-day event with a display alarm, weekly zoned event with UNTIL and EXDATE, Taqvim Persian rule with RDATE, repeated UID and an event without DTSTART; structure modelled on RFC 5545 and ADR-0013, contains no personal data
# url: https://www.rfc-editor.org/rfc/rfc5545
# retrieved: 2026-09-13
# reviewer: pending
# notes: synthetic; exercises RFC 5545 §3.6.1, §3.6.6, §3.8.5.1–§3.8.5.3, §3.8.8.2
BEGIN:VCALENDAR
PRODID:-//Taqvim//T-1003 fixture//EN
VERSION:2.0
BEGIN:VEVENT
UID:trip@taqvim.test
DTSTAMP:20260301T120000Z
DTSTART;VALUE=DATE:20260321
DTEND;VALUE=DATE:20260324
SUMMARY:Nowruz trip
DESCRIPTION:Synthetic all-day event
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Nowruz trip
TRIGGER:-PT15M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:standup@taqvim.test
DTSTAMP:20260301T120000Z
DTSTART;TZID=Europe/Berlin:20260706T090000
DTEND;TZID=Europe/Berlin:20260706T091500
SUMMARY:Standup
RRULE:FREQ=WEEKLY;BYDAY=MO,WE;UNTIL=20261230T080000Z
EXDATE;TZID=Europe/Berlin:20260708T090000
END:VEVENT
BEGIN:VEVENT
UID:esfand@taqvim.test
DTSTAMP:20260301T120000Z
DTSTART;VALUE=DATE:20250320
SUMMARY:Last day of Esfand
RDATE;VALUE=DATE:20260321
X-TAQVIM-RECURRENCE:CALENDAR=PERSIAN\;FREQ=YEARLY\;INTERVAL=1\;INVALID=NEXT_DAY\;WKST=SA
END:VEVENT
BEGIN:VEVENT
UID:trip@taqvim.test
DTSTAMP:20260301T120000Z
DTSTART;VALUE=DATE:20260401
SUMMARY:Repeated UID
END:VEVENT
BEGIN:VEVENT
UID:broken@taqvim.test
DTSTAMP:20260301T120000Z
SUMMARY:No start
END:VEVENT
END:VCALENDAR
