<?xml version="1.0" encoding="utf-8"?>
<!--
  Domain labels shared by more than one feature. `:core:ui` is where they belong: every Compose module already
  depends on it (ComposeConventionPlugins), so a name defined once here is reachable everywhere without any module
  depending on another feature, and without the same text being translated twice.

  Keep this file small. It is for names of domain concepts that several screens must call the same thing — not a
  general dumping ground for strings. Anything used by one feature stays in that feature, prefixed with its name.
  These are prefixed `shared_` so a merged resource table shows at a glance where a name comes from.
-->
<resources>
  <!-- Rules for deciding when an Islamic (lunar Hijri) month begins. Shown wherever a date's method is named. -->
  <!-- The resource key is historical: this method computes dates unless the user enables an official override. -->
  <string name="shared_islamic_variant_iran_official">Iran</string>
  <string name="shared_islamic_variant_umm_al_qura">Umm al-Qura</string>
  <string name="shared_islamic_variant_tabular_16">Tabular (type II)</string>
  <string name="shared_islamic_variant_tabular_15">Tabular (type I)</string>
  <string name="shared_islamic_variant_observational">Calculated crescent visibility</string>
  <!-- Generic date-picker chrome. Shared because the picker itself is shared; feature screens that already have
       their own copies keep them until someone consolidates, which is not this change. -->
  <string name="shared_picker_title">Choose a date</string>
  <string name="shared_picker_year">Year</string>
  <string name="shared_picker_month">Month</string>
  <string name="shared_picker_day">Day</string>
  <string name="shared_picker_confirm">Done</string>
  <string name="shared_picker_cancel">Cancel</string>
  <!-- Shown by a feature that notifies when the system will not show this app's notifications: the user turned
       them off, or refused POST_NOTIFICATIONS on Android 13+. Shared because four screens say the same thing. -->
  <string name="shared_notifications_blocked">Notifications are turned off for this app, so this cannot alert you.</string>
  <string name="shared_notifications_allow">Turn on notifications</string>
</resources>
