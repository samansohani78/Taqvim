<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application>
    <!--
      T-1200 widget refreshes. Only broadcasts exempt from the API 26 implicit-broadcast limits are declared;
      the day change and prayer times come from the widget framework's own alarm (explicit intent).
    -->
    <receiver
      android:name="ir.taqvim.feature.widgets.WidgetUpdateReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- Per-widget configuration; the launcher starts it when a widget is placed or reconfigured. -->
    <activity
      android:name="ir.taqvim.feature.widgets.WidgetConfigActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <!-- T-1201…T-1204 widgets: exported because the launcher sends APPWIDGET_UPDATE (ADR-0017 allowlist). -->
    <receiver
      android:name="ir.taqvim.feature.widgets.DateWidget1x1Receiver"
      android:exported="true"
      android:label="@string/widget_date_1x1_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_info_date_1x1" />
    </receiver>
    <receiver
      android:name="ir.taqvim.feature.widgets.DateClockWidget4x1Receiver"
      android:exported="true"
      android:label="@string/widget_date_clock_4x1_name">
