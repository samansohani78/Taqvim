<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher metadata of the week_strip widget; Glance draws the content, so no update period is needed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:configure="ir.taqvim.feature.widgets.WidgetConfigActivity"
  android:description="@string/widget_week_strip_description"
  android:initialLayout="@layout/glance_default_loading_layout"
  android:minWidth="250dp"
  android:minHeight="40dp"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="4"
  android:targetCellHeight="1"
  android:updatePeriodMillis="0"
  android:widgetCategory="home_screen"
  android:widgetFeatures="reconfigurable|configuration_optional"
  tools:targetApi="31" />
