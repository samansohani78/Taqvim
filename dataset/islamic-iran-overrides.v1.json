{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taqvim.ir/dataset/islamic-iran-overrides.v1.json",
  "title": "Taqvim Islamic Iran override table, version 1",
  "description": "Official Iranian lunar Hijri month starts as published by the Calendar Center (docs/PLAN.md §5.1, D-07); every month cites its calendar page. Cross-record rules (no duplicate months, no gaps inside the covered range, 29- or 30-day months, existing Persian dates) are enforced by :tools:dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "months"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "months": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/month"
      }
    }
  },
  "$defs": {
    "month": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hijriYear",
        "hijriMonth",
        "persianStart",
        "citation"
      ],
      "properties": {
        "hijriYear": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "hijriMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "persianStart": {
          "$ref": "#/$defs/persianDate"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "persianDate": {
      "description": "First day of the lunar month in the Solar Hijri calendar.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "page",
        "retrieved"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "description": "How the start follows from the printed page when it is not printed directly.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
