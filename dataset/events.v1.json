{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taqvim.ir/dataset/events.v1.json",
  "title": "Taqvim event dataset, version 1",
  "description": "One dataset file of holidays and observances; every record carries a citation (docs/PLAN.md §4.2, §5). Cross-record rules (unique ids, existing referenced events, day ranges per calendar, validity years) are enforced by :tools:dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "eventId": {
      "description": "Stable slug: lowercase dot-separated segments, e.g. ir.nowruz.1",
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "maxLength": 96
    },
    "calendar": {
      "enum": [
        "PERSIAN",
        "ISLAMIC",
        "GREGORIAN",
        "NEPALI",
        "HEBREW"
      ]
    },
    "source": {
      "enum": [
        "IRAN_OFFICIAL",
        "AFGHANISTAN_OFFICIAL",
        "NEPAL_OFFICIAL",
        "INTERNATIONAL",
        "ANCIENT_IRAN",
        "JEWISH",
        "CHRISTIAN"
      ]
    },
    "category": {
      "enum": [
        "NATIONAL",
        "RELIGIOUS",
        "INTERNATIONAL",
        "CULTURAL",
        "ASTRONOMICAL"
      ]
    },
    "flag": {
      "enum": [
        "ALWAYS_DISPLAYED",
        "HALF_DAY"
      ]
    },
    "weekday": {
      "enum": [
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY",
        "SUNDAY"
      ]
    },
    "astroKind": {
      "enum": [
        "MARCH_EQUINOX",
        "JUNE_SOLSTICE",
        "SEPTEMBER_EQUINOX",
        "DECEMBER_SOLSTICE",
        "NEW_MOON",
        "FULL_MOON"
      ]
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "year": {
      "type": "integer",
      "minimum": -9999,
      "maximum": 9999
    },
    "offsetDays": {
      "type": "integer",
      "minimum": -366,
      "maximum": 366
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localizedText": {
      "description": "Language tag → text; Persian (fa) is mandatory, or Nepali (ne) for records that carry only an official Nepali title (ADR-0038).",
      "type": "object",
      "if": {
        "not": {
          "required": [
            "ne"
          ]
        }
      },
      "then": {
        "required": [
          "fa"
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/languageTag"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "titleReview": {
      "description": "Language tags of `title` whose text is machine-translated from the official-source language and not yet reviewed by a human (owner decision 2026-09-23, ADR-0042, R07/D-05): the dataset equivalent of the app's `<!-- MT: needs review -->` string marker (docs/i18n/TRANSLATING.md). Each tag must also be a key of `title`; a reviewer removes the tag once the translation has been checked.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpUrl"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "retrieved": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "citation"
      ],
      "properties": {
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "fromYear": {
          "$ref": "#/$defs/year"
        },
        "toYear": {
          "$ref": "#/$defs/year"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Fixed",
            "NthWeekdayOfMonth",
            "LastWeekdayOfMonth",
            "LastDayOfMonth",
            "Single",
            "NthDayOfYear",
            "RelativeToEvent",
            "Astronomical",
            "LunarTithi",
            "Week",
            "JewishObservanceDate",
            "ChristianFeastDate"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Fixed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleFixed"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "NthWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleNthWeekdayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LastWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLastWeekdayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LastDayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLastDayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Single"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleSingle"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "NthDayOfYear"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleNthDayOfYear"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "RelativeToEvent"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleRelativeToEvent"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Astronomical"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleAstronomical"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LunarTithi"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLunarTithi"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Week"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleWeek"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "JewishObservanceDate"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleJewishObservanceDate"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ChristianFeastDate"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleChristianFeastDate"
          }
        }
      ]
    },
    "ruleFixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "day"
      ],
      "properties": {
        "type": {
          "const": "Fixed"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "day": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "ruleNthWeekdayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "weekday",
        "n"
      ],
      "properties": {
        "type": {
          "const": "NthWeekdayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "weekday": {
          "$ref": "#/$defs/weekday"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "ruleLastWeekdayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "weekday"
      ],
      "properties": {
        "type": {
          "const": "LastWeekdayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "weekday": {
          "$ref": "#/$defs/weekday"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        }
      }
    },
    "ruleLastDayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month"
      ],
      "properties": {
        "type": {
          "const": "LastDayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        }
      }
    },
    "ruleSingle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "year",
        "month",
        "day"
      ],
      "properties": {
        "type": {
          "const": "Single"
        },
        "year": {
          "$ref": "#/$defs/year"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "day": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "ruleNthDayOfYear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "n"
      ],
      "properties": {
        "type": {
          "const": "NthDayOfYear"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      }
    },
    "ruleRelativeToEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "eventId",
        "offsetDays"
      ],
      "properties": {
        "type": {
          "const": "RelativeToEvent"
        },
        "eventId": {
          "$ref": "#/$defs/eventId"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        }
      }
    },
    "ruleAstronomical": {
      "description": "The day of kind's instant, read in timeZone, plus offsetDays (ADR-0044). month is required for NEW_MOON and FULL_MOON (which recur about monthly) to name which one; equinoxes and solstices, which happen once a year, leave it out. When two such instants fall in the same civil month, the earlier is kept.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "offsetDays",
        "timeZone"
      ],
      "properties": {
        "type": {
          "const": "Astronomical"
        },
        "kind": {
          "$ref": "#/$defs/astroKind"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        },
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$"
        },
        "month": {
          "$ref": "#/$defs/month"
        }
      }
    },
    "ruleLunarTithi": {
      "description": "A Bikram Sambat lunar festival (ADR-0038): the day of tithi (1-30, 16-30 the dark half) of amanta lunar month (named by the solar month of its new moon), read at observance; with endTithi it lasts until the day of the next endTithi (read at sunrise) plus endOffsetDays. NEPALI calendar only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "tithi",
        "observance"
      ],
      "properties": {
        "type": {
          "const": "LunarTithi"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "tithi": {
          "$ref": "#/$defs/tithi"
        },
        "observance": {
          "enum": [
            "SUNRISE",
            "SUNSET",
            "MIDNIGHT"
          ]
        },
        "endTithi": {
          "$ref": "#/$defs/tithi"
        },
        "endOffsetDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "tithi": {
      "description": "Lunar day: 1-15 the bright half, 16-30 the dark half (30 = new moon).",
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "ruleWeek": {
      "description": "A lengthDays-day span starting on the day start resolves to (ADR-0046): every day of the span is an occurrence, so the app shows the record on each day of the week, the same way a LunarTithi record with endTithi already shows a multi-day festival. start is restricted (by the weekStart def) to a rule that needs neither another event nor astronomy to resolve on its own: Fixed, NthWeekdayOfMonth or LastWeekdayOfMonth.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "start",
        "lengthDays"
      ],
      "properties": {
        "type": {
          "const": "Week"
        },
        "start": {
          "$ref": "#/$defs/weekStart"
        },
        "lengthDays": {
          "type": "integer",
          "minimum": 2,
          "maximum": 14
        }
      }
    },
    "weekStart": {
      "description": "The day a Week rule starts on: a fixed date, the nth weekday of a month, or the last weekday of a month (with an optional offset).",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Fixed",
            "NthWeekdayOfMonth",
            "LastWeekdayOfMonth"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Fixed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleFixed"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "NthWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleNthWeekdayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LastWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLastWeekdayOfMonth"
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "calendar",
        "source",
        "category",
        "isHoliday",
        "title",
        "rule",
        "citations",
        "updated",
        "reviewedBy"
      ],
      "if": {
        "required": [
          "rule"
        ],
        "properties": {
          "rule": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LunarTithi"
              }
            }
          }
        }
      },
      "then": {
        "description": "Lunar months exist only in the Bikram Sambat calendar (ADR-0038).",
        "properties": {
          "calendar": {
            "const": "NEPALI"
          }
        }
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/eventId"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "isHoliday": {
          "type": "boolean"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "titleReview": {
          "$ref": "#/$defs/titleReview"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "oneOffReason": {
          "description": "Required for a Single rule and forbidden for every other rule: why the record is a one-off decision that no recurring rule can express (ADR-0036).",
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/httpUrl"
          }
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "JewishObservanceDate"
                  }
                }
              }
            }
          },
          "then": {
            "description": "Jewish observances are dated in the Hebrew calendar (T-108).",
            "properties": {
              "calendar": {
                "const": "HEBREW"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "ChristianFeastDate"
                  }
                }
              }
            }
          },
          "then": {
            "description": "Christian movable feasts are given as Gregorian days (T-109).",
            "properties": {
              "calendar": {
                "const": "GREGORIAN"
              }
            }
          }
        }
      ]
    },
    "scopeLevel": {
      "description": "How wide an observance is (DT-038). NATIONWIDE is the default a record without a scope already has.",
      "enum": [
        "NATIONWIDE",
        "PROVINCE",
        "DISTRICT",
        "REGION",
        "COMMUNITY"
      ]
    },
    "scopeArea": {
      "description": "A machine-readable area or audience id, namespaced by country, e.g. np.region.hill or np.community.newar. Ids are not resolved to coordinates: they exist so two records can say they mean the same group.",
      "type": "string",
      "pattern": "^[a-z]{2}\\.(province|district|region|community)\\.[a-z0-9-]+$"
    },
    "scope": {
      "description": "Who or where an observance applies to, when it is not the whole country (DT-038). Optional and additive: a record without it is nationwide, which is what every record meant before this field existed. The app shows `label` beside the event and does not filter by it, because it does not know the user's district.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/scopeLevel"
        },
        "areas": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scopeArea"
          }
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "if": {
        "properties": {
          "level": {
            "const": "NATIONWIDE"
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "description": "A nationwide record names no areas; leaving the scope out says the same thing.",
        "not": {
          "required": [
            "areas"
          ]
        }
      }
    },
    "jewishObservance": {
      "description": "One of the six Jewish observances with a fixed Hebrew date (T-108).",
      "enum": [
        "ROSH_HASHANAH",
        "YOM_KIPPUR",
        "SUCCOTH",
        "HANUKKAH",
        "PESACH",
        "SHAVUOT"
      ]
    },
    "movableFeast": {
      "description": "A Christian feast whose date moves with Easter, or the first Sunday of Advent (T-109).",
      "enum": [
        "ASH_WEDNESDAY",
        "PALM_SUNDAY",
        "GOOD_FRIDAY",
        "EASTER",
        "ASCENSION_DAY",
        "PENTECOST",
        "TRINITY_SUNDAY",
        "FIRST_SUNDAY_OF_ADVENT"
      ]
    },
    "christianRite": {
      "description": "WESTERN is the computus of the calendar in force (Julian before the 1582 reform, Gregorian after). ORTHODOX is the Julian computus throughout, shown on the Gregorian calendar; it has no FIRST_SUNDAY_OF_ADVENT.",
      "enum": [
        "WESTERN",
        "ORTHODOX"
      ]
    },
    "ruleJewishObservanceDate": {
      "description": "A Jewish observance on its Hebrew date, from `JewishObservances` (T-108). Not a Fixed rule: Hebrew month numbers shift in a leap year, so the engine is asked. HEBREW calendar only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "observance"
      ],
      "properties": {
        "type": {
          "const": "JewishObservanceDate"
        },
        "observance": {
          "$ref": "#/$defs/jewishObservance"
        }
      }
    },
    "ruleChristianFeastDate": {
      "description": "A Christian movable feast, from `ChristianMovableFeasts` (T-109). GREGORIAN calendar only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "feast",
        "rite"
      ],
