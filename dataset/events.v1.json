{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taqvim.ir/dataset/events.v1.json",
  "title": "Taqvim event dataset, version 1",
  "description": "One dataset file of holidays and observances; every record carries a citation (docs/PLAN.md §4.2, §5). Cross-record rules (unique ids, existing referenced events, day ranges per calendar, validity years) are enforced by :tools:dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "eventId": {
      "description": "Stable slug: lowercase dot-separated segments, e.g. ir.nowruz.1",
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "maxLength": 96
    },
    "calendar": {
      "enum": [
        "PERSIAN",
        "ISLAMIC",
        "GREGORIAN",
        "NEPALI"
      ]
    },
    "source": {
      "enum": [
        "IRAN_OFFICIAL",
        "AFGHANISTAN_OFFICIAL",
        "NEPAL_OFFICIAL",
        "INTERNATIONAL",
        "ANCIENT_IRAN"
      ]
    },
    "category": {
      "enum": [
        "NATIONAL",
        "RELIGIOUS",
        "INTERNATIONAL",
        "CULTURAL",
        "ASTRONOMICAL"
      ]
    },
    "flag": {
      "enum": [
        "ALWAYS_DISPLAYED",
        "HALF_DAY"
      ]
    },
    "weekday": {
      "enum": [
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY",
        "SUNDAY"
      ]
    },
    "astroKind": {
      "enum": [
        "MARCH_EQUINOX",
        "JUNE_SOLSTICE",
        "SEPTEMBER_EQUINOX",
        "DECEMBER_SOLSTICE",
        "NEW_MOON",
        "FULL_MOON"
      ]
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "year": {
      "type": "integer",
      "minimum": -9999,
      "maximum": 9999
    },
    "offsetDays": {
      "type": "integer",
      "minimum": -366,
      "maximum": 366
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localizedText": {
      "description": "Language tag → text; Persian (fa) is mandatory, or Nepali (ne) for records that carry only an official Nepali title (ADR-0038).",
      "type": "object",
      "if": {
        "not": {
          "required": [
            "ne"
          ]
        }
      },
      "then": {
        "required": [
          "fa"
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/languageTag"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "titleReview": {
      "description": "Language tags of `title` whose text is machine-translated from the official-source language and not yet reviewed by a human (owner decision 2026-09-23, ADR-0042, R07/D-05): the dataset equivalent of the app's `<!-- MT: needs review -->` string marker (docs/i18n/TRANSLATING.md). Each tag must also be a key of `title`; a reviewer removes the tag once the translation has been checked.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpUrl"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "retrieved": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "citation"
      ],
      "properties": {
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "fromYear": {
          "$ref": "#/$defs/year"
        },
        "toYear": {
          "$ref": "#/$defs/year"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Fixed",
            "NthWeekdayOfMonth",
            "LastWeekdayOfMonth",
            "LastDayOfMonth",
            "Single",
            "NthDayOfYear",
            "RelativeToEvent",
            "Astronomical",
            "LunarTithi"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Fixed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleFixed"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "NthWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleNthWeekdayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LastWeekdayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLastWeekdayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LastDayOfMonth"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLastDayOfMonth"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Single"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleSingle"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "NthDayOfYear"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleNthDayOfYear"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "RelativeToEvent"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleRelativeToEvent"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Astronomical"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleAstronomical"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LunarTithi"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ruleLunarTithi"
          }
        }
      ]
    },
    "ruleFixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "day"
      ],
      "properties": {
        "type": {
          "const": "Fixed"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "day": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "ruleNthWeekdayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "weekday",
        "n"
      ],
      "properties": {
        "type": {
          "const": "NthWeekdayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "weekday": {
          "$ref": "#/$defs/weekday"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "ruleLastWeekdayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "weekday"
      ],
      "properties": {
        "type": {
          "const": "LastWeekdayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "weekday": {
          "$ref": "#/$defs/weekday"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        }
      }
    },
    "ruleLastDayOfMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month"
      ],
      "properties": {
        "type": {
          "const": "LastDayOfMonth"
        },
        "month": {
          "$ref": "#/$defs/month"
        }
      }
    },
    "ruleSingle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "year",
        "month",
        "day"
      ],
      "properties": {
        "type": {
          "const": "Single"
        },
        "year": {
          "$ref": "#/$defs/year"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "day": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "ruleNthDayOfYear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "n"
      ],
      "properties": {
        "type": {
          "const": "NthDayOfYear"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      }
    },
    "ruleRelativeToEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "eventId",
        "offsetDays"
      ],
      "properties": {
        "type": {
          "const": "RelativeToEvent"
        },
        "eventId": {
          "$ref": "#/$defs/eventId"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        }
      }
    },
    "ruleAstronomical": {
      "description": "The day of kind's instant, read in timeZone, plus offsetDays (ADR-0044). month is required for NEW_MOON and FULL_MOON (which recur about monthly) to name which one; equinoxes and solstices, which happen once a year, leave it out. When two such instants fall in the same civil month, the earlier is kept.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "offsetDays",
        "timeZone"
      ],
      "properties": {
        "type": {
          "const": "Astronomical"
        },
        "kind": {
          "$ref": "#/$defs/astroKind"
        },
        "offsetDays": {
          "$ref": "#/$defs/offsetDays"
        },
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$"
        },
        "month": {
          "$ref": "#/$defs/month"
        }
      }
    },
    "ruleLunarTithi": {
      "description": "A Bikram Sambat lunar festival (ADR-0038): the day of tithi (1-30, 16-30 the dark half) of amanta lunar month (named by the solar month of its new moon), read at observance; with endTithi it lasts until the day of the next endTithi (read at sunrise) plus endOffsetDays. NEPALI calendar only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "month",
        "tithi",
        "observance"
      ],
      "properties": {
        "type": {
          "const": "LunarTithi"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "tithi": {
          "$ref": "#/$defs/tithi"
        },
        "observance": {
          "enum": [
            "SUNRISE",
            "SUNSET",
            "MIDNIGHT"
          ]
        },
        "endTithi": {
          "$ref": "#/$defs/tithi"
        },
        "endOffsetDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "tithi": {
      "description": "Lunar day: 1-15 the bright half, 16-30 the dark half (30 = new moon).",
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "calendar",
        "source",
        "category",
        "isHoliday",
        "title",
        "rule",
        "citations",
        "updated",
        "reviewedBy"
      ],
      "if": {
        "required": [
          "rule"
        ],
        "properties": {
          "rule": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LunarTithi"
              }
            }
          }
        }
      },
      "then": {
        "description": "Lunar months exist only in the Bikram Sambat calendar (ADR-0038).",
        "properties": {
          "calendar": {
            "const": "NEPALI"
          }
        }
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/eventId"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "isHoliday": {
          "type": "boolean"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "titleReview": {
          "$ref": "#/$defs/titleReview"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "oneOffReason": {
          "description": "Required for a Single rule and forbidden for every other rule: why the record is a one-off decision that no recurring rule can express (ADR-0036).",
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/httpUrl"
          }
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
